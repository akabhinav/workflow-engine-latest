<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.tranto</groupId>
        <artifactId>tranto</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!--
      The scripts plugin: run inline scripts through an interpreter (shell, python, ...). Like every
      plugin it compiles against the SDK only (scope 'provided') — it cannot see the engine — and the
      Tranto annotation processor writes its ServiceLoader manifest so the engine discovers it.
    -->
    <artifactId>tranto-plugin-scripts</artifactId>
    <name>Tranto :: Plugin Scripts (script runner)</name>

    <dependencies>
        <dependency>
            <groupId>io.tranto</groupId>
            <artifactId>tranto-plugin-sdk</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test-only: spin up the real engine to prove the plugin runs end-to-end. -->
        <dependency>
            <groupId>io.tranto</groupId>
            <artifactId>tranto-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.tranto</groupId>
            <artifactId>tranto-plugin-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths combine.self="override">
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>io.tranto</groupId>
                            <artifactId>tranto-processor</artifactId>
                            <version>${project.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
